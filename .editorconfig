root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sol}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# the specification documents 01-17 and the changelog keep CRLF line endings
[spec/{0,1}*.md]
end_of_line = unset
[spec/CHANGELOG.md]
end_of_line = unset

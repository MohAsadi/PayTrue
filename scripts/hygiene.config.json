{
  "_comment": "Settings of scripts/repo_hygiene.py. protectedIdentifiers are the cryptographic identifiers that a blind rename of the product name would change: see docs/rename-impact.md before editing any of them.",
  "maxFileMiB": 50,
  "warnFileMiB": 20,
  "ownSpdx": "Apache-2.0",
  "allowedThirdPartySpdx": [
    "MIT",
    "Apache-2.0",
    "MIT OR Apache-2.0"
  ],
  "thirdPartySourcePrefixes": [
    "spec/foundry/lib/forge-std/"
  ],
  "secretAllowPaths": [
    "spec/foundry/lib/forge-std/"
  ],
  "forbiddenTrackedPrefixes": [
    "spec/toolchain/bin/",
    "spec/toolchain/_download/",
    "spec/toolchain/solc/",
    "spec/toolchain/isolated/",
    "spec/toolchain/permit2-build/",
    "contracts/out/",
    "contracts/cache/",
    "contracts/broadcast/",
    "spec/foundry/out/",
    "spec/foundry/cache/",
    "node_modules/"
  ],
  "encodingSkipSuffixes": [
    ".gz"
  ],
  "allowTrackedPatterns": [
    ".env.example"
  ],
  "forbiddenTrackedPatterns": [
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.keystore",
    "id_rsa*",
    "id_ed25519*",
    ".env",
    ".env.*",
    "*.exe",
    "*.dll",
    "*.dylib",
    "*.zip",
    "*.tgz",
    "*.tar.gz",
    "*.7z",
    "*.mp4",
    "*.mov",
    "*.har",
    "*.heic"
  ],
  "privateEvidencePatterns": [
    "spec/evidence/wallet-lab/*.png",
    "spec/evidence/wallet-lab/*.jpg",
    "spec/evidence/wallet-lab/*.jpeg",
    "spec/evidence/wallet-lab/*.pdf",
    "spec/evidence/wallet-lab/*.gif",
    "spec/evidence/wallet-lab/*.webp",
    "spec/evidence/wallet-lab/*/raw/*"
  ],
  "requiredFiles": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "GOVERNANCE.md",
    "TRADEMARK.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    ".gitignore",
    ".gitattributes",
    ".editorconfig",
    ".env.example",
    ".github/CODEOWNERS",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml",
    "docs/README.md"
  ],
  "hostCheckDirs": [
    "packages",
    "deploy",
    "examples",
    "contracts",
    "scripts"
  ],
  "deniedHostPattern": "paytrue\\.(me|com|io|app|dev|cloud)",
  "packagesMustBePrivateUntilRelease": true,
  "protectedIdentifiers": [
    {
      "id": "EIP712-DOMAIN-MANDATES",
      "kind": "EIP-712 domain name (part of the domain separator)",
      "string": "FastPay Mandates",
      "mustAppearIn": [
        "spec/eip712/types.json",
        "contracts/src/generated/FastPayTypes.sol",
        "spec/eip712/fastpay-types.generated.ts",
        "spec/eip712/golden-vectors.json"
      ],
      "keccak256": "ed345e4b13fb27d8593d4308bc2e940615cba3572a35c442b76ca1beb38d491f"
    },

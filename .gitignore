# Toolchain binaries, downloaded archives and compilers. They are pinned by URL and SHA-256 in
# spec/toolchain/toolchain.lock.json and fetched again by spec/toolchain/fetch_toolchain.py;
# several of them are larger than GitHub accepts (100 MB per file) or recommends (50 MB).
spec/toolchain/bin/
spec/toolchain/_download/
spec/toolchain/solc/

# Build output of the Foundry projects (rebuilt by tools/contracts_report.py and spec/toolchain/forge.py)
contracts/out/
contracts/cache/
contracts/broadcast/
spec/foundry/out/
spec/foundry/cache/

# Working copy that tools/contracts_mutation.py creates and deletes
contracts_mut/
contracts_mut_*/

# Python bytecode
__pycache__/
*.pyc

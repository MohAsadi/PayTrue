    /// The model registry of price bands (ADR-020): the same table as protocol_model.band; version 0 and every unpublished version are the empty band.
    function test_BoundsBands() public pure {
        (uint256 lo0, uint256 hi0) = ContainModel.band(0);
        assertEq(lo0, 1);
        assertEq(hi0, 0);
        (uint256 lo1, uint256 hi1) = ContainModel.band(1);
        assertEq(lo1, 98);
        assertEq(hi1, 102);
        (uint256 lo2, uint256 hi2) = ContainModel.band(2);
        assertEq(lo2, 95);
        assertEq(hi2, 105);
        (uint256 lo3, uint256 hi3) = ContainModel.band(3);
        assertEq(lo3, 96);
        assertEq(hi3, 104);
        (uint256 lo4, uint256 hi4) = ContainModel.band(4);
        assertEq(lo4, 94);
        assertEq(hi4, 106);
        (uint256 lo5, uint256 hi5) = ContainModel.band(5);
        assertEq(lo5, 90);
        assertEq(hi5, 110);
        (uint256 lo6, uint256 hi6) = ContainModel.band(6);
        assertEq(lo6, 1);
        assertEq(hi6, 0);
        (uint256 lo7, uint256 hi7) = ContainModel.band(7);
        assertEq(lo7, 1);
        assertEq(hi7, 0);
        (uint256 lo4294967295, uint256 hi4294967295) = ContainModel.band(4294967295);
        assertEq(lo4294967295, 1);
        assertEq(hi4294967295, 0);
    }

    /// MIG-TV-22 and 40: Permit2 usability is a > 0 and now <= expiration.
    function test_Permit2Usable() public {
        assertEq(AllowanceMath.usable(1, 100, 99), true);
        assertEq(AllowanceMath.usable(1, 100, 100), true);
        assertEq(AllowanceMath.usable(1, 100, 101), false);
        assertEq(AllowanceMath.usable(0, 100, 50), false);
        assertEq(AllowanceMath.usable(1461501637330902918203684832716283019655932542975, 100, 100), true);
        assertEq(AllowanceMath.usable(1461501637330902918203684832716283019655932542975, 100, 101), false);
        assertEq(AllowanceMath.usable(1, 0, 0), true);
        assertEq(AllowanceMath.usable(1, 0, 1), false);
        assertEq(AllowanceMath.usable(5, 281474976710655, 281474976710655), true);
        assertEq(AllowanceMath.usable(5, 281474976710655, 281474976710656), false);
    }

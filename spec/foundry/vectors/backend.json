      "part": "a plan that contains lockdown(t, Rold) while a sibling uses t is refused by the validator (NC-20)"
    },
    {
      "id": "MIG-TV-41",
      "owner": "planner",
      "part": "the planner refuses approve(t, R, 50, T+10) while a sibling relies on the slot (NC-21)"
    },
    {
      "id": "MIG-TV-42",
      "owner": "orchestrator",
      "part": "the orchestrator raises ALLOWANCE_SHORTFALL before submitting a charge that would revert"
    },
    {
      "id": "MIG-TV-44",
      "owner": "planner and orchestrator",

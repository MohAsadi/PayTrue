# PayTrue environment example. GENERATED by packages/config/scripts/generate-env-example.mjs from packages/config/src/schema.js; do not edit by hand.
# Copy to `.env` (which is ignored by Git) and change the values. Never commit secrets.
# A line that starts with `#` shows the default or an example; uncomment it to set it. Names with <chainId> stand for one variable per chain.

# ---- Runtime: where PayTrue is served, which chains and contracts it uses, sessions and webhooks, optional Cloud
# `development` or `production`. Production requires https origins, at least two RPC URLs per chain, and refuses the development stub.
# Default: development
# PAYTRUE_ENV=production

# The origin (scheme, host, optional port) under which the operator serves PayTrue. Never a path.
# Required: production.
# Default: http://localhost:8080 (development only)
# PAYTRUE_PUBLIC_ORIGIN=https://pay.example.com

# The path under which PayTrue is mounted on that origin. `/` for a subdomain or a dedicated host, `/paytrue` for a path on an existing site.
# Default: /
# PAYTRUE_BASE_PATH=/paytrue

# The origin that serves the hosted checkout pages. Give it its own origin (a subdomain) when you can: the checkout runs a strict content security policy and no merchant code.
# Default: PAYTRUE_PUBLIC_ORIGIN
# PAYTRUE_CHECKOUT_ORIGIN=https://checkout.example.com

# The path under which the hosted checkout is mounted on its origin.
# Default: PAYTRUE_BASE_PATH
# PAYTRUE_CHECKOUT_BASE_PATH=/

# The route prefix of a hosted checkout session: `<origin><base path><route>/<session id>`.
# Default: /c
# PAYTRUE_CHECKOUT_ROUTE=/c

# The origin of the merchant API, when it is not the public origin.
# Default: PAYTRUE_PUBLIC_ORIGIN
# PAYTRUE_API_ORIGIN=https://api.example.com

# The path under which the merchant API (`/v1/...`) is mounted on its origin.
# Default: PAYTRUE_BASE_PATH
# PAYTRUE_API_BASE_PATH=/

# `true` when your reverse proxy removes the base path before forwarding, `false` when it forwards the path unchanged.
# Default: false
# PAYTRUE_PROXY_STRIPS_BASE_PATH=true

# Space- or comma-separated origins that may embed the hosted checkout in an iframe. Empty means `frame-ancestors 'none'`. Embedded checkout is separately gated in the specification.
# Default: (empty: nobody may embed the checkout)
# PAYTRUE_ALLOWED_FRAME_ANCESTORS=https://shop.example.com https://www.example.com

# Cookie domain for the checkout control cookie. Leave unset for a host-only cookie. When set it must be the checkout host or a parent domain of it.
# Default: (unset: host-only cookie)
# PAYTRUE_COOKIE_DOMAIN=example.com

# Cookie path of the checkout control cookie.
# Default: PAYTRUE_CHECKOUT_BASE_PATH
# PAYTRUE_COOKIE_PATH=/

# `strict`, `lax` or `none`. `none` is needed only for a cross-site embed and requires production with https.
# Default: strict
# PAYTRUE_COOKIE_SAMESITE=strict

# Comma-separated chain ids this deployment accepts payments on.
# Required: production.
# Default: 31337 (development only)
# PAYTRUE_CHAIN_IDS=8453,42161

# Comma-separated RPC URLs of one chain. Production needs at least two distinct hosts: a money decision rests on two independent sources.
# Required: production, for every chain id.
# Default: http://127.0.0.1:8545 for 31337 (development only)
# PAYTRUE_RPC_URLS_<chainId>=https://rpc-a.example.org,https://rpc-b.example.net

# The deployment manifest (README, section Deploy your own contracts) that names the contract addresses of your own deployment. PayTrue ships no canonical addresses.
# Required: production.
# Default: deployments/local-31337.json (development only)
# PAYTRUE_DEPLOYMENT_FILE=deployments/sovereign-8453.json

# Minimum session lifetime a merchant may request. A proposal (record CSR-01); not an approved constant.
# Default: 600
# PAYTRUE_SESSION_LIFETIME_MIN_SECONDS=600

# Session lifetime when a request gives none (30 minutes).
# Default: 1800
# PAYTRUE_SESSION_LIFETIME_DEFAULT_SECONDS=1800

# Maximum session lifetime a merchant may request.
# Default: 86400
# PAYTRUE_SESSION_LIFETIME_MAX_SECONDS=86400

# The signing secret of your webhook endpoint. Never commit it.
# SECRET: keep it out of Git and out of logs.
# PAYTRUE_WEBHOOK_SECRET=(a long random value)

# How far a webhook timestamp may differ from the receiver's clock before the event is rejected as a replay. A proposal.
# Default: 300
# PAYTRUE_WEBHOOK_TOLERANCE_SECONDS=300

# The merchant API key used by the SDK and the examples. Never commit it.
# SECRET: keep it out of Git and out of logs.
# PAYTRUE_API_KEY=(your merchant API key)

# PayTrue Cloud is optional and off by default. Nothing in this repository requires it.
# Default: false
# PAYTRUE_CLOUD_ENABLED=false

# The base URL of a PayTrue Cloud API. There is no default: the repository never assumes a hosted service.
# Required: PAYTRUE_CLOUD_ENABLED=true.
# PAYTRUE_CLOUD_BASE_URL=(only if you use Cloud)

# ---- Development stub (packages/devserver): never used in production
# Interface the development stub listens on.
# Default: 127.0.0.1
# PAYTRUE_LISTEN_HOST=127.0.0.1

# Port the development stub listens on.
# Default: 8080
# PAYTRUE_LISTEN_PORT=8080

# Where the development stub delivers signed webhook events (for the examples and tests).
# PAYTRUE_WEBHOOK_URL=http://127.0.0.1:9000/webhooks

# ---- Contract deployment (contracts/script/Deploy.s.sol); a legacy FASTPAY_* name is read when the PAYTRUE_* one is unset
# The Permit2 contract of the chain.
# Required: deploying.
# PAYTRUE_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# The governance address. A timelock in production.
# Required: deploying.
# PAYTRUE_GOVERNANCE=(a timelock address)

# The guardian address (stop-only).
# Required: deploying.
# PAYTRUE_GUARDIAN=(a stop-only address)

# The pause authority of the mandate manager.
# Required: deploying.
# PAYTRUE_RISK_AUTHORITY=(an address)

# Immutable ceiling of a quote's life, in seconds (PC-06).
# Required: deploying.
# PAYTRUE_MAX_QUOTE_TTL=300

# Immutable ceiling of a price band, in basis points (PC-07).
# Required: deploying.
# PAYTRUE_MAX_BAND_WIDTH_BPS=500

# Grace of quotes issued before a signer-set rotation, in seconds (PC-08).
# Required: deploying.
# PAYTRUE_QUOTE_SET_GRACE=300

# Immutable fee ceiling in basis points. No value is proposed (PC-05).
# Required: deploying.
# PAYTRUE_FEE_CEILING_BPS=(your value)

# The initial fee, at most the ceiling.
# Required: deploying.
# PAYTRUE_FEE_BPS=(your value)

# The fee recipient.
# Required: deploying.
# PAYTRUE_FEE_RECIPIENT=(an address)

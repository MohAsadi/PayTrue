# The same layout as same-domain-path.Caddyfile, but the PROXY removes the /paytrue prefix before forwarding:
#   PAYTRUE_PUBLIC_ORIGIN=https://example.com   PAYTRUE_BASE_PATH=/paytrue   PAYTRUE_PROXY_STRIPS_BASE_PATH=true
# The application still builds URLs WITH the prefix (it knows its base path); it just receives paths without it.
# Not run by this repository's checks: validate with `caddy validate --config <this file>` before use.

example.com {
	# ... your existing site stays here, unchanged ...

	handle_path /paytrue/* {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			-Server
		}
		reverse_proxy 127.0.0.1:8080
	}
}
